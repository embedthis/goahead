#
#   Local developer configuration
#
.cdrc
.cdrc.bat
.local.mk
.promoted
.claude/.cc-writes/
.claude/settings.local.json

#
#   Editor and OS artifacts
#
.DS_Store
.tags*
*.swp

#
#   Build output
#
build/
*.o
bun.lock
bun.lockb
node_modules/
paks/

#
#   IDE user state (the generated projects under projects/ are tracked)
#
.vs/
projects/*-mine*
projects/**/*.sdf
projects/**/*.suo
projects/**/*.user
**/project.xcworkspace/
**/xcuserdata/

#
#   Generated certificates (copied into test/ by test/prep.sh)
#
certs/dist/
test/self.crt
test/self.key

#
#   Test artifacts
#
.testme/
*.log
test/cgi-bin/*
!test/cgi-bin/.keep
test/tmp/*
!test/tmp/.keep
test/web/tmp/*
!test/web/tmp/.keep
test/web/huge.txt

#
#   Web fixtures generated by test/prep.sh
#
test/web/café/
test/web/fifo.txt
