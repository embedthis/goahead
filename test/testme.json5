{
    /*
        GoAhead is single threaded and every test shares the one test server. The DoS and stress
        tests deliberately saturate the server's connection table, so a test running concurrently
        with them has its connection refused and fails for no fault of its own. Run tests serially.
        The suite is I/O bound against a single server, so parallelism buys almost nothing anyway.
     */
    execution: {
        parallel: false,
        /*
            regress/cgi-timeout-detach.tst holds a CGI silent past the server's 60 second request
            timeout, so it cannot finish inside the 30 second default. A nested testme.json5 is not
            an option: the nearest config wins outright rather than merging, so a per-directory file
            would drop the environment block below. Every other test is fast, and this is a ceiling
            rather than a wait, so a hung test still fails -- just later.

            soak/soak.tst.ts runs for a duration chosen by --depth: 3 seconds at depth 0, 240 at
            depth 5, an hour at depth 9. From depth 5 it meets this ceiling and from depth 6 it
            exceeds it, so a deep soak needs its own ceiling on the command line:

                tm --depth 6 -t 600 soak

            The ceiling is deliberately not raised to suit the deepest soak. It is the only thing
            that turns a wedged server into a failure rather than a hang, and every other test in
            the suite finishes in seconds.
         */
        timeout: 240,
    },
    compiler: {
        c: {
            gcc: {
                flags: [
                    '-Wformat=2', '-Wformat-security', '-Werror=format-security',
                    '-Wsign-compare', '-Wsign-conversion',
                    '-I../src', '-I../src/osdep', '-L../build/bin',
                    '-include', '${CONFIGDIR}/../build/test/goahead-features.h',
                    '-Wl,-rpath,${CONFIGDIR}/../build/bin'
                ],
                libraries: ['m', 'crypto', 'ssl', 'goahead'],
            },
            msvc: {
                flags: [
                    '-GR-', '-MDd', '-wd4100',
                    '/I../src', '/I../src/osdep',
                    '/FI${CONFIGDIR}/../build/test/goahead-features.h',
                    '/LIBPATH:../build/bin',
                    '/I${ME_COM_OPENSSL_PATH}/include',
                    '/LIBPATH:${ME_COM_OPENSSL_PATH}/lib/VC/${ARCH}/MDd',
                    '/I${USERPROFILE}/vcpkg/installed/${ARCH}-windows/include',
                    '/LIBPATH:${USERPROFILE}/vcpkg/installed/${ARCH}-windows/lib',
                ],
                libraries: ['libcrypto', 'libssl', 'libgoahead.lib', 'ws2_32.lib', 'advapi32.lib', 'user32.lib', 'kernel32.lib', 'oldnames.lib', 'shell32.lib'],
            },
        },
    },
    environment: {
        default: {
            PATH: '../build/bin:${PATH}',
            TM_HTTP: 'http://127.0.0.1:18080',
            TM_HTTPS: 'https://127.0.0.1:14443',
            TM_HTTPV6: 'http://[::1]:18090',
            TM_HTTPSV6: 'https://[::1]:14453',
            /*
                Feature gates come from the build via services.environment. TLS is configured separately;
                set this to 0 for builds without TLS.
             */
            ME_SSL: '1',
            /*
                IPv6 axis. The test server binds its IPv6 endpoints best-effort, so on a host with
                no IPv6 loopback the rest of the suite still runs -- set this to 0 there and
                test/ipv6 skips instead of failing.
             */
            ME_IPV6: '1',
        },
        windows: {
            PATH: '../build/bin;C:/Program Files/OpenSSL;${USERPROFILE}/vcpkg/installed/${ARCH}-windows/bin;${PATH}',
        },
    },
    services: {
        /*
            Export build flags to TypeScript tests and the forced C header.
            ME_GOAHEAD_STEALTH selects basic/methods.tst.ts expectations.
         */
        environment: './utils/features.sh',
        setup: './setup.sh',
        prep: './prep.sh',
        cleanup: './cleanup.sh',
        healthcheck: { url: 'http://localhost:18080/index.html' },
    },
}
